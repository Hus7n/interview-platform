# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Required ─────────────────────────────────────────────────────
# PostgreSQL connection string, e.g.
# postgresql://postgres:postgres@localhost:5432/interview_platform
psql 'postgresql://neondb_owner:npg_cCPKtGN1SeT3@ep-purple-waterfall-aounhod8-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Must be at least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-random-32-plus-character-secret"

# ── CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Password hashing ─────────────────────────────────────────────
# bcrypt rounds, 10-15
PASSWORD_SALT_ROUNDS=12

# ── Code execution (Piston sandbox) ──────────────────────────────
# The public emkc.org instance is whitelist-only as of 2026-02-15, so the
# interview room's Run/Test buttons need a self-hosted Piston instance.
# Point this at your own deployment to enable execution.
PISTON_URL=https://emkc.org

# ── First admin (created by `npm run seed`) ─────────────────────
# Public registration refuses the admin role, so seed one account here.
ADMIN_EMAIL=admin@interview.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# ── Email (optional - required for verification & reset links) ────
# Leave blank to use the built-in console transport in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@interview.local